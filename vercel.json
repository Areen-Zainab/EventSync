{
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "devCommand": "cd frontend && npm run dev",
  "outputDirectory": "frontend/.next",
  "installCommand": "npm install --prefix ./frontend",
  "framework": "nextjs",
  "functions": {
    "frontend/**/*.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
