# Backend Environment Variables Example
# Copy this to .env.local or .env.production and fill in actual values

NODE_ENV=development
PORT=5000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=eventsync

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
